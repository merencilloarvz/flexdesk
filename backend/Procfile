web: echo "=== START $(date -u +%H:%M:%S) ===" && python manage.py collectstatic --noinput && echo "=== COLLECTSTATIC DONE $(date -u +%H:%M:%S) ===" && python manage.py migrate --noinput && echo "=== MIGRATE DONE $(date -u +%H:%M:%S) ===" && gunicorn config.wsgi --bind 0.0.0.0:$PORT --workers 3 --timeout 60