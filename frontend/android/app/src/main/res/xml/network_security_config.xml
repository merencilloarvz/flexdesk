<?xml version="1.0" encoding="utf-8"?>
<!-- Shipped config: https only, no exceptions. Local-testing exceptions
     live in src/debug, src/profile and src/lanTesting (opt-in, see
     app/build.gradle.kts). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
