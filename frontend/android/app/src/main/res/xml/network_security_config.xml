<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext (HTTP) allowed ONLY for local dev backends — never for
         production. If a build ever tries plain HTTP against anything not
         listed here, it fails loudly instead of silently downgrading.
         Keep this in sync with the local IPs used in ApiConfig
         (FLEXDESK_API_BASE_URL override / platform defaults). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.100.35</domain>
        <domain includeSubdomains="false">192.168.68.227</domain>
        <domain includeSubdomains="false">192.168.100.33</domain>
    </domain-config>
    <!-- Everything else (including production) defaults to
         cleartextTrafficPermitted="false" via the platform default —
         no base-config override here means HTTPS is required. -->
</network-security-config>